<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="RequireExternalRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AgenticaRoot)' == ''" Text="Pass an explicit pinned AgenticaRoot." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(AgenticaRoot)/Agentica.Lab.Web/Agentica.Lab.Web.csproj" />
  </ItemGroup>
</Project>
