# Public build-time travel policy. Restart Vite or rebuild after changing.
# Copy values into .env.local for local overrides. Never put provider keys here.
# A nonnegative integer is a ceiling; 0 is zero allowance, NOT unlimited.
# "none" and "unlimited" remove that policy ceiling explicitly.
VITE_MAZE_TRAVEL_STEPS=64
VITE_MAZE_TRAVEL_REPLANS=4
VITE_MAZE_TRAVEL_DURATION_MS=120000

# Optional App Agentica profile, disabled when all VITE_AGENTICA_* settings are absent.
# PUBLIC BUILD-TIME VALUES: visible in the browser bundle; never put credentials,
# API keys, tokens or private service configuration in VITE_* variables.
# Restart Vite or rebuild after changing. Configuration alone never starts a run.
# Set ENDPOINT, PROVIDER and MODEL together. Blank/invalid/unknown settings fail;
# omitted numeric settings use the bounded defaults shown below. No unlimited values.
# Endpoint: ws/wss ending exactly in /api/host, no credentials/query/fragment.
# Plain ws is allowed only for localhost, 127.0.0.1 or [::1].
# Provider: fixture or openai. Model must be explicitly selected; no model discovery.
# VITE_AGENTICA_ENDPOINT=ws://127.0.0.1:5079/api/host
# VITE_AGENTICA_PROVIDER=fixture
# VITE_AGENTICA_MODEL=fixture-model
# Optional explicit provider thinking-effort identifier; omitted means unspecified.
# VITE_AGENTICA_THINKING_EFFORT=high
# Safe decimal integers; all positive except refinements/continuations may be zero.
# Output tokens must not exceed context tokens. Timeouts are in seconds.
# VITE_AGENTICA_CONTEXT_WINDOW_TOKENS=8192
# VITE_AGENTICA_MAX_OUTPUT_TOKENS=256
# VITE_AGENTICA_MAX_STEPS=8
# VITE_AGENTICA_MAX_REFINEMENTS=6
# VITE_AGENTICA_MAX_PLAN_CONTINUATIONS=0
# VITE_AGENTICA_TIMEOUT_SECONDS=120
# VITE_AGENTICA_ACTION_TIMEOUT_SECONDS=15
